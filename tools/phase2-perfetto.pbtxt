# Phase 2 app inference/conversion and compositor evidence; omit system scheduler flood.
buffers { size_kb: 65536 fill_policy: RING_BUFFER }
duration_ms: 60000
write_into_file: true
file_write_period_ms: 1000
flush_period_ms: 1000
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_apps: "com.aiphotographer.app"
    }
  }
}
data_sources { config { name: "linux.process_stats" process_stats_config { proc_stats_poll_ms: 1000 } } }
data_sources { config { name: "android.surfaceflinger.frametimeline" } }
