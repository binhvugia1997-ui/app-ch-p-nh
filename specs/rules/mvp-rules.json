{
  "$schema": "../schemas/rule-set.schema.json",
  "version": "0.1.0",
  "status": "PHASE_0_DRAFT",
  "notes": [
    "Normative for rule IDs, classes, severities, implementation phases and threshold status. Prose meaning lives in docs/photography-rules.md.",
    "Scope: the rules specified to implementation depth (Phases 4-6). Rules described only in prose in docs/photography-rules.md are added here when their phase begins.",
    "Every threshold with status CALIBRATION_REQUIRED must not drive a user-visible hard error until calibrated on local captures (enforced by a unit test).",
    "Threshold values here are proposals. They are not evidence."
  ],
  "rules": [
    {
      "ruleId": "FRAME_SUBJECT_PRESENT",
      "name": "Subject present and usable",
      "category": "FRAMING",
      "purpose": "Gate for every other framing/pose rule; drives the no-subject UI state.",
      "class": "HIGH_CONFIDENCE_ERROR",
      "detectability": "DETERMINISTIC",
      "actor": "PHOTOGRAPHER",
      "severity": "BLOCKING",
      "blockingAllowed": true,
      "applicableShotTypes": [
        "ANY"
      ],
      "requiredInputs": [
        "subjects[].visibleFraction",
        "subjects[].bbox"
      ],
      "detectionMethod": [
        "Pick the most prominent subject: prominence = visibleFraction * sqrt(bboxArea).",
        "If visibleFraction < V_min, report SUBJECT_PARTIAL.",
        "If no subject for N_absent consecutive frames, report NO_SUBJECT."
      ],
      "math": "prominence = visibleFraction * sqrt(bboxArea)",
      "thresholds": [
        {
          "name": "V_min",
          "value": 0.55,
          "unit": "ratio",
          "status": "CALIBRATION_REQUIRED",
          "exitValue": 0.6
        },
        {
          "name": "N_absent",
          "value": 15,
          "unit": "frames@30fps",
          "status": "CALIBRATION_REQUIRED"
        }
      ],
      "confidenceCap": 0.95,
      "suggestedActions": [
        "WAIT"
      ],
      "conflictingRules": [],
      "failureCases": [
        "partially occluded subject",
        "subject beyond ~4 m (model-card limit)",
        "severe motion blur"
      ],
      "implementationPriority": "MVP",
      "phase": 5,
      "complexity": "S"
    },
    {
      "ruleId": "FRAME_SUBJECT_TOO_SMALL",
      "name": "Subject too small for the intended shot type",
      "category": "FRAMING",
      "purpose": "A small subject cannot be judged and the pose is unreadable.",
      "class": "HIGH_CONFIDENCE_ERROR",
      "detectability": "DETERMINISTIC",
      "actor": "PHOTOGRAPHER",
      "severity": "IMPORTANT",
      "blockingAllowed": true,
      "applicableShotTypes": [
        "FULL_BODY",
        "THREE_QUARTER",
        "HALF_BODY",
        "CLOSE_PORTRAIT",
        "HEADSHOT"
      ],
      "requiredInputs": [
        "subjects[].bbox",
        "subjects[].face.bbox",
        "intendedShotType"
      ],
      "detectionMethod": [
        "Compute h_body = bbox.height and h_face = faceBBox.height in normalized frame units.",
        "Compare with the band for the intended shot type.",
        "Enter when below the band minimum; exit 10% inside the band."
      ],
      "math": "bands (proposal, CALIBRATION_REQUIRED): FULL_BODY 0.75-0.98; THREE_QUARTER 0.55-0.85; HALF_BODY 0.35-0.60; CLOSE_PORTRAIT face 0.18-0.35; HEADSHOT face 0.28-0.45",
      "thresholds": [
        {
          "name": "fullBodyMin",
          "value": 0.75,
          "unit": "ratio_of_frame_height",
          "status": "CALIBRATION_REQUIRED",
          "source": "PRACTITIONER/CALIBRATION",
          "exitValue": 0.79
        },
        {
          "name": "extremeWarnOnly",
          "value": 0.25,
          "unit": "ratio_of_frame_height",
          "status": "CALIBRATION_REQUIRED",
          "source": "used when no shot type is selected"
        }
      ],
      "confidenceCap": 0.95,
      "suggestedActions": [
        "MOVE_CLOSER",
        "ZOOM_IN"
      ],
      "conflictingRules": [
        "FRAME_HEADROOM_EXCESSIVE",
        "FRAME_SUBJECT_TOO_LARGE"
      ],
      "failureCases": [
        "bbox clipped by the frame edge",
        "loose clothing",
        "overlapping people"
      ],
      "implementationPriority": "MVP",
      "phase": 5,
      "complexity": "S"
    },
    {
      "ruleId": "FRAME_SUBJECT_TOO_LARGE",
      "name": "Subject too large / cropped by the frame",
      "category": "FRAMING",
      "purpose": "A subject that overflows the frame reads as an accident unless deliberately tight.",
      "class": "HIGH_CONFIDENCE_ERROR",
      "detectability": "DETERMINISTIC",
      "actor": "PHOTOGRAPHER",
      "severity": "IMPORTANT",
      "blockingAllowed": true,
      "applicableShotTypes": [
        "FULL_BODY",
        "THREE_QUARTER",
        "HALF_BODY"
      ],
      "requiredInputs": [
        "subjects[].bbox",
        "intendedShotType"
      ],
      "detectionMethod": [
        "h_body compared against the band maximum.",
        "Enter above the band maximum; exit 10% inside."
      ],
      "math": "see FRAME_SUBJECT_TOO_SMALL bands",
      "thresholds": [
        {
          "name": "fullBodyMax",
          "value": 0.98,
          "unit": "ratio_of_frame_height",
          "status": "CALIBRATION_REQUIRED",
          "exitValue": 0.94
        }
      ],
      "confidenceCap": 0.95,
      "suggestedActions": [
        "MOVE_FARTHER",
        "ZOOM_OUT"
      ],
      "conflictingRules": [
        "FRAME_JOINT_CROP",
        "FRAME_EDGE_MARGIN"
      ],
      "failureCases": [
        "deliberate tight crop",
        "subject walking toward the camera"
      ],
      "implementationPriority": "MVP",
      "phase": 5,
      "complexity": "S"
    },
    {
      "ruleId": "FRAME_HEADROOM_EXCESSIVE",
      "name": "Excessive headroom",
      "category": "FRAMING",
      "purpose": "Most consistently cited portrait framing error; trivially measurable.",
      "class": "HIGH_CONFIDENCE_ERROR",
      "detectability": "HYBRID",
      "actor": "PHOTOGRAPHER",
      "severity": "IMPORTANT",
      "blockingAllowed": false,
      "applicableShotTypes": [
        "HEADSHOT",
        "CLOSE_PORTRAIT",
        "HALF_BODY",
        "THREE_QUARTER",
        "FULL_BODY"
      ],
      "requiredInputs": [
        "subjects[].landmarks(eyes,ears,nose)",
        "frame.height",
        "intendedShotType"
      ],
      "detectionMethod": [
        "Estimate headTopY: fit a circle through both eyes and both ears; headTopY = centreY - k * radius.",
        "headroomRatio = headTopY (normalized distance from the frame top).",
        "Compare with the band for the intended shot type; require eyes/ears visibility >= 0.5."
      ],
      "math": "headTopY = circleCentreY - k * circleRadius, k ~ 1.45 (CALIBRATION_REQUIRED); headroomRatio = headTopY / frameHeight",
      "thresholds": [
        {
          "name": "headshotMax",
          "value": 0.14,
          "unit": "ratio_of_frame_height",
          "status": "CALIBRATION_REQUIRED",
          "source": "PRACTITIONER; crafting convention 1/8-1/4 for head-and-shoulders",
          "exitValue": 0.11
        },
        {
          "name": "fullBodyMax",
          "value": 0.2,
          "unit": "ratio_of_frame_height",
          "status": "CALIBRATION_REQUIRED",
          "exitValue": 0.16
        },
        {
          "name": "headTopK",
          "value": 1.45,
          "unit": "dimensionless",
          "status": "CALIBRATION_REQUIRED"
        }
      ],
      "confidenceCap": 0.85,
      "suggestedActions": [
        "INCREASE_HEADROOM"
      ],
      "conflictingRules": [
        "FRAME_SUBJECT_TOO_SMALL"
      ],
      "failureCases": [
        "head partially out of frame (abstain)",
        "hats/hair volume",
        "camera roll > 10 deg",
        "head not upright"
      ],
      "implementationPriority": "MVP",
      "phase": 5,
      "complexity": "M"
    },
    {
      "ruleId": "FRAME_HEADROOM_INSUFFICIENT",
      "name": "Insufficient headroom / head near the top edge",
      "category": "FRAMING",
      "purpose": "A head jammed against (or cut by) the top edge looks cramped.",
      "class": "HIGH_CONFIDENCE_ERROR",
      "detectability": "HYBRID",
      "actor": "PHOTOGRAPHER",
      "severity": "IMPORTANT",
      "blockingAllowed": false,
      "applicableShotTypes": [
        "HEADSHOT",
        "CLOSE_PORTRAIT",
        "HALF_BODY",
        "THREE_QUARTER",
        "FULL_BODY"
      ],
      "requiredInputs": [
        "subjects[].landmarks",
        "frame.height"
      ],
      "detectionMethod": [
        "Same headTopY estimate as FRAME_HEADROOM_EXCESSIVE.",
        "Enter below the band minimum; exit 10% inside."
      ],
      "math": "headroomRatio < bandMin",
      "thresholds": [
        {
          "name": "headshotMin",
          "value": 0.04,
          "unit": "ratio_of_frame_height",
          "status": "CALIBRATION_REQUIRED",
          "exitValue": 0.055
        },
        {
          "name": "fullBodyMin",
          "value": 0.03,
          "unit": "ratio_of_frame_height",
          "status": "CALIBRATION_REQUIRED",
          "exitValue": 0.045
        }
      ],
      "confidenceCap": 0.85,
      "suggestedActions": [
        "DECREASE_HEADROOM"
      ],
      "conflictingRules": [
        "FRAME_SUBJECT_TOO_SMALL",
        "COMP_EYE_LINE_PLACEMENT"
      ],
      "failureCases": [
        "head outside the frame (abstain, do not report)",
        "severe roll"
      ],
      "implementationPriority": "MVP",
      "phase": 5,
      "complexity": "M"
    },
    {
      "ruleId": "FRAME_EDGE_MARGIN",
      "name": "Subject touching or crossing the frame edge",
      "category": "FRAMING",
      "purpose": "Subjects pinned to the edge read as accidental.",
      "class": "CONTEXT_DEPENDENT_ISSUE",
      "detectability": "DETERMINISTIC",
      "actor": "PHOTOGRAPHER",
      "severity": "NUDGE",
      "blockingAllowed": false,
      "applicableShotTypes": [
        "FULL_BODY",
        "THREE_QUARTER",
        "HALF_BODY"
      ],
      "requiredInputs": [
        "subjects[].bbox",
        "frame"
      ],
      "detectionMethod": [
        "Compute the four margins from the bbox to the frame edges.",
        "Flag when min(margin) < m_min, suppressing tight-crop shot types."
      ],
      "math": "m_left = bbox.left, etc.; flag if min(margins) < m_min",
      "thresholds": [
        {
          "name": "m_min",
          "value": 0.02,
          "unit": "ratio_of_frame",
          "status": "CALIBRATION_REQUIRED",
          "exitValue": 0.03
        }
      ],
      "confidenceCap": 0.9,
      "suggestedActions": [
        "ZOOM_OUT",
        "SUBJECT_MOVE_INWARD",
        "REFRAME"
      ],
      "conflictingRules": [
        "FRAME_SUBJECT_TOO_SMALL"
      ],
      "failureCases": [
        "deliberate tight crops",
        "subject entering/leaving the frame while walking"
      ],
      "implementationPriority": "MVP",
      "phase": 5,
      "complexity": "S"
    },
    {
      "ruleId": "FRAME_JOINT_CROP",
      "name": "Crop cutting through a joint",
      "category": "FRAMING",
      "purpose": "Cropping at a joint reads as unintentional; a mid-limb crop reads as a choice.",
      "class": "CONTEXT_DEPENDENT_ISSUE",
      "detectability": "DETERMINISTIC",
      "actor": "PHOTOGRAPHER",
      "severity": "NUDGE",
      "blockingAllowed": false,
      "applicableShotTypes": [
        "FULL_BODY",
        "THREE_QUARTER",
        "HALF_BODY"
      ],
      "requiredInputs": [
        "subjects[].landmarks + visibility",
        "frame"
      ],
      "detectionMethod": [
        "For each skeleton segment intersecting a frame edge, compute the intersection parameter t along the segment.",
        "Flag when t < t_joint or t > 1 - t_joint AND the nearest joint is closer to the edge than d_joint."
      ],
      "math": "t_joint = 0.15; d_joint = 0.03 * frameHeight",
      "thresholds": [
        {
          "name": "t_joint",
          "value": 0.15,
          "unit": "ratio_along_segment",
          "status": "CALIBRATION_REQUIRED"
        },
        {
          "name": "d_joint",
          "value": 0.03,
          "unit": "ratio_of_frame_height",
          "status": "CALIBRATION_REQUIRED"
        }
      ],
      "confidenceCap": 0.9,
      "suggestedActions": [
        "ZOOM_OUT",
        "SUBJECT_MOVE_INWARD",
        "REFRAME"
      ],
      "conflictingRules": [
        "FRAME_SUBJECT_TOO_SMALL"
      ],
      "failureCases": [
        "occluded landmarks distorting the segment",
        "sitting/crouching poses where legs are legitimately cropped"
      ],
      "implementationPriority": "MVP",
      "phase": 5,
      "complexity": "M"
    },
    {
      "ruleId": "FRAME_SUBJECT_OFF_CENTER_EXTREME",
      "name": "Subject squeezed into a corner / extreme imbalance",
      "category": "FRAMING",
      "purpose": "Detect only extreme imbalance; centering itself is not an error.",
      "class": "HIGH_CONFIDENCE_ERROR",
      "detectability": "DETERMINISTIC",
      "actor": "PHOTOGRAPHER",
      "severity": "NUDGE",
      "blockingAllowed": false,
      "applicableShotTypes": [
        "ANY"
      ],
      "requiredInputs": [
        "subjects[].bbox",
        "subjects[].face.headPose.yawDegrees"
      ],
      "detectionMethod": [
        "offset = |bboxCentre - frameCentre| normalized by half the frame.",
        "Flag only if offset > threshold and the subject is not deliberately looking into negative space."
      ],
      "math": "offset = 2 * |bboxCentre - frameCentre| / frameSize",
      "thresholds": [
        {
          "name": "extremeOffset",
          "value": 0.55,
          "unit": "ratio_of_half_frame",
          "status": "CALIBRATION_REQUIRED",
          "exitValue": 0.45
        }
      ],
      "confidenceCap": 0.9,
      "suggestedActions": [
        "REFRAME",
        "SUBJECT_MOVE_INWARD"
      ],
      "conflictingRules": [
        "COMP_LEAD_ROOM"
      ],
      "failureCases": [
        "intentional negative space",
        "subject moving through the frame"
      ],
      "implementationPriority": "MVP",
      "phase": 5,
      "complexity": "S"
    },
    {
      "ruleId": "FRAME_CAMERA_TILT",
      "name": "Unintended camera roll",
      "category": "FRAMING",
      "purpose": "Horizon tilt is objectively measurable from the IMU and is a common 'looks wrong' cause.",
      "class": "CONTEXT_DEPENDENT_ISSUE",
      "detectability": "DETERMINISTIC",
      "actor": "PHOTOGRAPHER",
      "severity": "NUDGE",
      "blockingAllowed": false,
      "applicableShotTypes": [
        "ANY"
      ],
      "requiredInputs": [
        "device.rollDegrees"
      ],
      "detectionMethod": [
        "Compute roll from the gravity vector, compensate for display rotation.",
        "EMA-smooth; enter above threshold, exit below a smaller one."
      ],
      "math": "rollDeg = atan2(gx, gy) adjusted for display rotation",
      "thresholds": [
        {
          "name": "enter",
          "value": 1.5,
          "unit": "degrees",
          "status": "CALIBRATION_REQUIRED",
          "exitValue": 1.0
        }
      ],
      "confidenceCap": 0.95,
      "suggestedActions": [
        "LEVEL_CAMERA"
      ],
      "conflictingRules": [],
      "failureCases": [
        "intentional Dutch tilt",
        "IMU unavailable (abstain)"
      ],
      "implementationPriority": "MVP",
      "phase": 5,
      "complexity": "S"
    },
    {
      "ruleId": "FRAME_BRIGHT_BLOB_BEHIND_HEAD",
      "name": "Bright region behind the head",
      "category": "COMPOSITION",
      "purpose": "Cheap, deterministic proxy for a distracting bright background.",
      "class": "CONTEXT_DEPENDENT_ISSUE",
      "detectability": "DETERMINISTIC",
      "actor": "PHOTOGRAPHER",
      "severity": "NUDGE",
      "blockingAllowed": false,
      "applicableShotTypes": [
        "HEADSHOT",
        "CLOSE_PORTRAIT",
        "HALF_BODY",
        "THREE_QUARTER"
      ],
      "requiredInputs": [
        "luma grid",
        "subjects[].face.bbox"
      ],
      "detectionMethod": [
        "Find connected components of luma >= 0.85 on the 64x64 grid.",
        "Flag when a component overlaps the head bbox perimeter with area > 0.5 * head bbox area."
      ],
      "math": "blobArea / headArea > 0.5",
      "thresholds": [
        {
          "name": "blobLuma",
          "value": 0.85,
          "unit": "normalized_luma",
          "status": "CALIBRATION_REQUIRED"
        },
        {
          "name": "blobAreaRatio",
          "value": 0.5,
          "unit": "ratio",
          "status": "CALIBRATION_REQUIRED"
        }
      ],
      "confidenceCap": 0.6,
      "suggestedActions": [
        "REFRAME"
      ],
      "conflictingRules": [],
      "failureCases": [
        "intentional rim light",
        "bright sky as background"
      ],
      "implementationPriority": "MVP",
      "phase": 5,
      "complexity": "M"
    },
    {
      "ruleId": "POSE_MATCH_SCORE",
      "name": "Pose match score against the active template",
      "category": "POSE",
      "purpose": "Primary pose quality signal; drives the dashed guide and readiness.",
      "class": "CONTEXT_DEPENDENT_ISSUE",
      "detectability": "DETERMINISTIC",
      "actor": "SUBJECT",
      "severity": "INFO",
      "blockingAllowed": false,
      "applicableShotTypes": [
        "ANY"
      ],
      "requiredInputs": [
        "subjects[].landmarks + worldLandmarks",
        "activeTemplate"
      ],
      "detectionMethod": [
        "See docs/pose-system.md §4: usability mask, SUBJECT normalization, Kabsch alignment with a ±25 deg clamp, component scoring with coverage gating, weighted aggregation."
      ],
      "math": "score = sum_c W(c)*coverage(c)^alpha*componentScore(c) / sum_c W(c)*coverage(c)^alpha",
      "thresholds": [
        {
          "name": "bandMatched",
          "value": 0.85,
          "unit": "score",
          "status": "CALIBRATION_REQUIRED"
        },
        {
          "name": "bandClose",
          "value": 0.7,
          "unit": "score",
          "status": "CALIBRATION_REQUIRED"
        },
        {
          "name": "bandDifferent",
          "value": 0.45,
          "unit": "score",
          "status": "CALIBRATION_REQUIRED"
        },
        {
          "name": "minCoveragePerComponent",
          "value": 0.35,
          "unit": "ratio",
          "status": "CALIBRATION_REQUIRED"
        },
        {
          "name": "visibleFractionGate",
          "value": 0.5,
          "unit": "ratio",
          "status": "CALIBRATION_REQUIRED"
        },
        {
          "name": "rotationClamp",
          "value": 25,
          "unit": "degrees",
          "status": "SETTLED",
          "source": "design decision, docs/pose-system.md §4.3"
        }
      ],
      "confidenceCap": 0.95,
      "suggestedActions": [],
      "conflictingRules": [],
      "failureCases": [
        "more than 60% of the body invisible (report POSE_UNVERIFIABLE, not a low score)",
        "template degeneracy"
      ],
      "implementationPriority": "MVP",
      "phase": 4,
      "complexity": "L"
    },
    {
      "ruleId": "POSE_ARM_TORSO_GAP_TOO_SMALL",
      "name": "Arm pressed against the torso",
      "category": "POSE",
      "purpose": "The most commonly cited posing issue in credible sources: pressed arms flatten and widen the arm silhouette and read as tense.",
      "class": "HIGH_CONFIDENCE_ERROR",
      "detectability": "DETERMINISTIC",
      "actor": "SUBJECT",
      "severity": "IMPORTANT",
      "blockingAllowed": false,
      "applicableShotTypes": [
        "HALF_BODY",
        "THREE_QUARTER",
        "FULL_BODY",
        "CLOSE_PORTRAIT"
      ],
      "requiredInputs": [
        "shoulder/elbow/wrist/hip landmarks + visibility",
        "torso length"
      ],
      "detectionMethod": [
        "Build the torso axis from mid-shoulder to mid-hip.",
        "For each side, take the minimum distance from the upper-arm and forearm segments to the torso axis.",
        "Compute the arm-torso angle (upper arm vs torso axis).",
        "Flag when gapRatio < threshold OR armTorsoAngle < threshold; require visibility >= 0.5 for that side."
      ],
      "math": "gapRatio = minDistance / torsoLength; armTorsoAngle = angle(shoulder->elbow, hip->shoulder)",
      "thresholds": [
        {
          "name": "gapRatioMin",
          "value": 0.1,
          "unit": "ratio_of_torso_length",
          "status": "CALIBRATION_REQUIRED",
          "exitValue": 0.125
        },
        {
          "name": "armTorsoAngleMin",
          "value": 12,
          "unit": "degrees",
          "status": "CALIBRATION_REQUIRED",
          "source": "floored by pose angle noise (~8-11 deg RMSE)",
          "exitValue": 15
        }
      ],
      "confidenceCap": 0.8,
      "suggestedActions": [
        "MOVE_ARM_AWAY_FROM_TORSO",
        "HAND_ON_HIP",
        "RAISE_LEFT_ARM",
        "RAISE_RIGHT_ARM"
      ],
      "conflictingRules": [
        "templates that intend arms close to the body (formal A-pose)"
      ],
      "failureCases": [
        "camera along the body axis (foreshortening hides a real gap)",
        "loose sleeves",
        "arms behind the back"
      ],
      "implementationPriority": "MVP",
      "phase": 4,
      "complexity": "M"
    },
    {
      "ruleId": "POSE_ELBOW_LOCKED",
      "name": "Fully straight (locked) elbow or knee",
      "category": "POSE",
      "purpose": "Locked joints look stiff: 'if it bends, bend it'. Same measurement and same fix for elbows and knees, so it is one rule.",
      "class": "CONTEXT_DEPENDENT_ISSUE",
      "detectability": "DETERMINISTIC",
      "actor": "SUBJECT",
      "severity": "NUDGE",
      "blockingAllowed": false,
      "applicableShotTypes": [
        "HALF_BODY",
        "THREE_QUARTER",
        "FULL_BODY"
      ],
      "requiredInputs": [
        "shoulder/elbow/wrist landmarks",
        "hip/knee/ankle landmarks"
      ],
      "detectionMethod": [
        "Interior joint angle, computed per joint (both elbows, both knees).",
        "Compare against the active template's expected angle when a template is active; otherwise use the absolute threshold."
      ],
      "math": "theta = angle(proximal->joint, joint->distal); locked when theta > 170 deg (elbow: shoulder-elbow-wrist; knee: hip-knee-ankle)",
      "thresholds": [
        {
          "name": "lockedAngle",
          "value": 170,
          "unit": "degrees",
          "status": "CALIBRATION_REQUIRED",
          "exitValue": 165
        }
      ],
      "confidenceCap": 0.8,
      "suggestedActions": [
        "SUBJECT_TURN_LEFT",
        "SUBJECT_TURN_RIGHT"
      ],
      "conflictingRules": [
        "elongation-style templates"
      ],
      "failureCases": [
        "intentionally extended limbs",
        "walking mid-stride",
        "knee hidden by clothing"
      ],
      "implementationPriority": "NEXT",
      "phase": 6,
      "complexity": "S"
    },
    {
      "ruleId": "POSE_WRIST_ANGLE_EXTREME",
      "name": "Broken or limp wrist",
      "category": "POSE",
      "purpose": "An extreme wrist angle reads as an accident.",
      "class": "CONTEXT_DEPENDENT_ISSUE",
      "detectability": "HYBRID",
      "actor": "SUBJECT",
      "severity": "NUDGE",
      "blockingAllowed": false,
      "applicableShotTypes": [
        "HALF_BODY",
        "CLOSE_PORTRAIT",
        "HEADSHOT"
      ],
      "requiredInputs": [
        "elbow/wrist/index/pinky landmarks"
      ],
      "detectionMethod": [
        "Hand direction proxy = wrist -> midpoint(index, pinky).",
