{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/binhvugia1997-ui/app-ch-p-nh/specs/schemas/pose-template.schema.json",
  "title": "PoseTemplate",
  "description": "A pose defined as normalized landmark geometry in SUBJECT space: origin at the hip midpoint, y down, unit = torso length (mid-shoulder to mid-hip = 1.0). Templates are never raster images.",
  "type": "object",
  "required": ["id", "name", "peopleCount", "shotTypes", "landmarks", "mirrorAllowed", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+_v[0-9]+$" },
    "name": {
      "type": "object",
      "description": "Localized display names; at least vi and en.",
      "required": ["vi", "en"],
      "additionalProperties": { "type": "string" }
    },
    "peopleCount": { "type": "integer", "minimum": 1, "maximum": 8 },
    "shotTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["HEADSHOT", "CLOSE_PORTRAIT", "HALF_BODY", "THREE_QUARTER", "FULL_BODY", "ENVIRONMENTAL", "CANDID", "EDITORIAL", "SEATED_PORTRAIT"] }
    },
    "contextTags": {
      "type": "array",
      "description": "Scene tags this pose suits (see docs/scene-understanding.md §3). Empty until Phase 7.",
      "items": { "enum": ["indoor", "outdoor", "urban_street", "architecture", "park_greenery", "nature_open", "water", "home_interior", "cafe_restaurant", "studio_plain", "wall_close", "tight_space", "open_space"] }
    },
    "difficulty": { "enum": ["TRIVIAL", "EASY", "MEDIUM", "HARD"] },
    "mirrorAllowed": { "type": "boolean", "description": "Whether the matcher may evaluate the mirrored handedness (and the guide may draw it)." },
    "mirrorPenalty": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.85, "description": "Score multiplier applied when mirroring is used against a template that does not allow it." },
    "orientationExpectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "torsoYawDeg": { "type": "number", "description": "Torso yaw: 0 = facing the camera, 90 = full profile." },
        "toleranceDeg": { "type": "number", "default": 20 }
      }
    },
    "frame": {
      "type": "object",
      "description": "Guidance for the photographer (never used for matching).",
      "additionalProperties": false,
      "properties": {
        "cameraHeight": { "enum": ["GROUND", "KNEE", "WAIST", "CHEST", "EYE", "ABOVE_EYE"] },
        "cameraDistanceHint": { "type": "string" },
        "headroomBand": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "subjectHeightFraction": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
      }
    },
    "landmarks": {
      "type": "array",
      "description": "Template landmarks in SUBJECT space. Every entry must use an anatomical BlazePose id.",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "x", "y"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": ["number", "null"] },
          "weight": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0, "description": "Matching weight for this landmark." },
          "required": { "type": "boolean", "default": false, "description": "If true, the pose cannot be verified without it (pose-system.md §4.5)." },
          "component": { "enum": ["HEAD", "TORSO", "LEFT_ARM", "RIGHT_ARM", "LEFT_LEG", "RIGHT_LEG"] }
        }
      }
    },
    "jointAngles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["joint", "value"],
        "additionalProperties": false,
        "properties": {
          "joint": { "type": "string", "description": "e.g. left_elbow, right_knee, torso_lean, shoulder_line" },
          "value": { "type": "number", "description": "Expected interior angle in degrees." },
          "tolerance": { "type": "number", "minimum": 10, "default": 25, "description": "Degrees; must not be below the measurement-noise floor (docs/photography-rules.md §3)." },
          "weight": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 }
        }
      }
    },
    "relativeVectors": {
      "type": "array",
      "description": "Unit-vector expectations between landmarks (direction matters, length does not).",
      "items": {
        "type": "object",
        "required": ["from", "to", "dir"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "dir": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "Approximate unit vector in SUBJECT space." },
          "weight": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 }
        }
      }
    },
    "componentWeights": {
      "type": "object",
      "description": "Per-component matching weights; defaults applied when absent.",
      "additionalProperties": false,
      "properties": {
        "HEAD": { "type": "number" },
        "TORSO": { "type": "number" },
        "LEFT_ARM": { "type": "number" },
        "RIGHT_ARM": { "type": "number" },
        "LEFT_LEG": { "type": "number" },
        "RIGHT_LEG": { "type": "number" }
      }
    },
    "bodyOrientation": {
      "type": "object",
      "description": "Orientation expectations for the matcher and the guide.",
      "additionalProperties": false,
      "properties": {
        "shoulderAngleDeg": {
          "type": "number",
          "description": "Signed tilt of the shoulder line, degrees, normalized to (-90, 90]. Computed as the angle of the left_shoulder -> right_shoulder vector; POSITIVE means the line descends toward image +x (for a subject facing the camera: the subject's anatomical left shoulder is lower in the frame)."
        },
        "hipAngleDeg": {
          "type": "number",
          "description": "Same convention as shoulderAngleDeg, using left_hip -> right_hip."
        },
        "facingDeg": { "type": "number", "description": "Torso yaw: 0 = facing the camera, 90 = full profile." }
      }
    },
    "cameraRecommendations": { "type": "array", "items": { "type": "string" } },
    "compositionRecommendations": { "type": "array", "items": { "type": "string" } },
    "intentFlags": {
      "type": "object",
      "description": "Switches that suppress normally-generated corrections when the pose intends them.",
      "additionalProperties": false,
      "properties": {
        "suppressForeshorteningWarning": { "type": "boolean", "default": false },
        "suppressSymmetryWarning": { "type": "boolean", "default": false },
        "suppressLockedJointWarning": { "type": "boolean", "default": false },
        "suppressArmTorsoTightWarning": { "type": "boolean", "default": false }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "status": { "enum": ["SEED_UNVALIDATED", "VALIDATED", "DEPRECATED"] },
        "calibration": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string" }
      }
    }
  }
}
